# Copy to `.env.local` for local overrides. Never commit real secrets.
# Everything here ends up in the public app bundle, so none of it may be secret.

VITE_APP_ENV=development

# Dropbox app key (public, from dropbox.com/developers/apps). No secret is used (PKCE).
VITE_DROPBOX_APP_KEY=

# Google Form "pre-filled link" URLs
VITE_FORM_DELETE_URL=
VITE_FORM_ISSUE_URL=

# Community and support (https:// or mailto: only). Leave empty until ready.
VITE_LINK_WHATSAPP=
VITE_LINK_X=
VITE_LINK_INSTAGRAM=
VITE_LINK_STRAVA=
VITE_LINK_EMAIL=
VITE_LINK_DONATE=
VITE_LINK_DROPBOX_VIDEO=

# owner/name of the GitHub repo (used for update checks)
VITE_REPO=byshriv/replift
